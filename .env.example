# ═══════════════════════════════════════════════════════════════
#  Hotel PMS — Frontend Environment Variables
#  Copy to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# The API base URL used by the browser.
# Dev (local or docker): /api   — proxied by Vite to VITE_API_TARGET
# Production:            https://api.your-domain.com/api
VITE_API_URL=/api

# The proxy target for Vite dev server (NOT used in production builds).
# Local:  http://localhost:4000
# Docker: http://backend:4000
VITE_API_TARGET=http://localhost:4000
